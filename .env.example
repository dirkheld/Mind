DATABASE_URL=postgresql://mind:mind@127.0.0.1:5432/mind
# Runtime-only connection; use the same restricted role as DATABASE_URL here.
# Keep the administrative DIRECT_URL separately in .env.migrations (CLI only).
DIRECT_URL=postgresql://mind:mind@127.0.0.1:5432/mind
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Comma-separated verified account emails. Empty means no admin access.
ADMIN_EMAILS=
EMAIL_SERVER=smtp://127.0.0.1:1025
EMAIL_FROM=MIND <noreply@localhost>
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_REASONING_MODEL=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
REDIS_URL=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
SENTRY_DSN=
